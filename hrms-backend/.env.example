# Copy this file to .env and fill in real values — NEVER commit .env
NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/hrms_dev

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_64_RANDOM_HEX_CHARS
JWT_EXPIRES_IN=1h

# Refresh token secret (different from access token secret)
REFRESH_TOKEN_SECRET=CHANGE_ME_USE_64_RANDOM_HEX_CHARS
REFRESH_TOKEN_EXPIRES_IN=7d

# Groq API key — obtain from console.groq.com
GROQ_API_KEY=CHANGE_ME

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173

# Cookie settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Copy this file to .env.local and fill in values — NEVER commit .env.local
# Only VITE_ prefixed variables are embedded in the browser bundle.
# Do NOT put secrets here.

# Set to "true" to show quick-login demo buttons on the login page (dev only)
VITE_DEMO_MODE=true

VITE_AI_API_KEY=your_gemini_api_key_here
VITE_API_URL=https://your-backend.up.railway.app